{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentKnife",
  "version": "1.0.0",
  "identifier": "com.agentknife.app",
  "build": {
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ak-shell" },
    "devUrl": "http://127.0.0.1:47120",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ak-shell" },
    "frontendDist": "../ak-shell/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentKnife",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
